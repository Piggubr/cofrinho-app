<?xml version="1.0" encoding="utf-8"?>
<!--
    Toque longo no ícone: os atalhos do app Capacitor, nos links que o MainActivity já entende
    (Links.kt). O "lancar-gasto" mantém o id de lá, para o atalho fixado continuar. A demo tem a
    sua cópia (src/demo/res/xml), com o pacote .demo.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="lancar-gasto"
        android:shortcutLongLabel="@string/atalho_lancar_gasto"
        android:shortcutShortLabel="@string/atalho_lancar_gasto">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="piggu://gasto"
            android:targetClass="br.com.piggu.app.MainActivity"
            android:targetPackage="br.com.piggu.app" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="ver-gastos"
        android:shortcutLongLabel="@string/atalho_ver_gastos_longo"
        android:shortcutShortLabel="@string/atalho_ver_gastos">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="piggu://gastos"
            android:targetClass="br.com.piggu.app.MainActivity"
            android:targetPackage="br.com.piggu.app" />
    </shortcut>
</shortcuts>
