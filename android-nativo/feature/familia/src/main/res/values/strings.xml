    <string name="familia_confirma_convite_titulo">Entrar na %1$s?</string>
    <string name="familia_confirma_convite">Você sai da família atual: se for a última pessoa dela, tudo o que está lá é apagado; se outras pessoas ficarem, o que você lançou fica com elas. Depois disso é preciso entrar de novo.</string>
    <string name="familia_confirma_parceria_titulo">Aceitar ser parceiro?</string>
    <string name="familia_confirma_parceria">Você e o titular passam a ver e editar o que um e o outro lançam, e o que lançam os menores de 18 anos. Depois disso é preciso entrar de novo.</string>
    <string name="familia_confirma_convidar_titulo">Convidar %1$s para ser parceiro?</string>
    <string name="familia_confirma_convidar">Quando a pessoa aceitar, vocês dois passam a ver e editar o que um e o outro lançam, e o que lançam os menores de 18 anos. Plano, convites e pessoas continuam só com você.</string>
    <string name="familia_confirma_voltar_titulo">Voltar %1$s a membro?</string>
    <string name="familia_confirma_voltar">Essa pessoa passa a ver só o que ela lança, e você deixa de ver o dela.</string>
    <string name="familia_confirma_remover_titulo">Tirar %1$s da família?</string>
    <string name="familia_confirma_remover">A pessoa leva o que lançou e a família deixa de ver.</string>
    <string name="familia_confirma_sair_titulo">Sair da família?</string>
