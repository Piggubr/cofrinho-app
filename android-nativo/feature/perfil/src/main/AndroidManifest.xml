<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Perfil > Avisos > Notificação neste aparelho (Android 13 ou mais novo). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- A foto tirada pela câmera. Subclasse própria: dois androidx.core FileProvider no mesmo app colidem no manifesto. -->
        <provider
            android:name="br.com.piggu.feature.perfil.ArquivosDoPerfil"
            android:authorities="${applicationId}.perfil.arquivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/perfil_arquivos" />
        </provider>
    </application>
</manifest>
