<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.intuit.ofx</string>
			<key>UTTypeDescription</key>
			<string>Extrato OFX</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ofx</string>
					<string>qfx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-ofx</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>GIDClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<key>GIDServerClientID</key>
	<string>$(GOOGLE_SERVER_CLIENT_ID)</string>
	<key>PigguAPIURL</key>
	<string>$(PIGGU_API_URL)</string>
	<key>PigguRefreshNoCorpo</key>
	<string>$(PIGGU_REFRESH_NO_CORPO)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>br.com.piggu.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>piggu</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_IOS_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
