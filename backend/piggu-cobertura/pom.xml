<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.piggu</groupId>
    <artifactId>piggu-backend</artifactId>
    <version>1.0.0</version>
  </parent>

  <!-- Sem codigo: junta a cobertura de todos os modulos num relatorio so, para o Sonar.
       O relatorio de cada modulo so conta os testes dele; aqui o codigo do piggu-common
       que os servicos exercitam nos testes deles tambem aparece coberto. Os pisos
       continuam por modulo (cobertura.* em cada pom). -->
  <artifactId>piggu-cobertura</artifactId>
  <name>Piggu Cobertura</name>
  <packaging>pom</packaging>

  <!-- So os modulos: o report-aggregate le as classes e a cobertura deles; as bibliotecas
       que eles usam nao interessam aqui. -->
  <dependencies>
    <dependency>
      <groupId>com.piggu</groupId>
      <artifactId>piggu-common</artifactId>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.piggu</groupId>
      <artifactId>piggu-gateway</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.piggu</groupId>
      <artifactId>piggu-identity</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.piggu</groupId>
      <artifactId>piggu-finance</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.piggu</groupId>
      <artifactId>piggu-rewards</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.piggu</groupId>
      <artifactId>piggu-lifestyle</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.piggu</groupId>
      <artifactId>piggu-media</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.piggu</groupId>
      <artifactId>piggu-banking</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>relatorio-unico</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
