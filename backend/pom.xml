<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.9</version>
    <relativePath/>
  </parent>

  <groupId>com.piggu</groupId>
  <artifactId>piggu-backend</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Piggu Backend</name>
  <description>Plataforma de microservicos do Piggu</description>

  <modules>
    <module>piggu-common</module>
    <module>piggu-testing</module>
    <module>piggu-gateway</module>
    <module>piggu-identity</module>
    <module>piggu-finance</module>
    <module>piggu-rewards</module>
    <module>piggu-lifestyle</module>
    <module>piggu-media</module>
    <module>piggu-banking</module>
    <module>piggu-cobertura</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-cloud.version>2025.1.4</spring-cloud.version>
    <google-api-client.version>2.9.1</google-api-client.version>
    <google-drive.version>v3-rev20260916-2.0.0</google-drive.version>
    <!-- O cliente Docker que o Testcontainers usa negocia por padrao uma versao de
         API anterior a 1.40, recusada por daemons Docker recentes. Fixar aqui vale
         para todos os modulos; 1.43 e aceita por Docker 20.10 em diante. -->
    <docker.api.version>1.43</docker.api.version>
    <jacoco.version>0.8.13</jacoco.version>
    <checkstyle.version>14.3.0</checkstyle.version>
    <!-- Gera o contrato da API (docs/api) a partir dos controllers. A linha 3.0 e a do
         Spring Boot 4.0 (a 3.1 em diante ja e compilada contra o Boot 4.1). So liga no
         perfil dev e nos testes: em producao /v3/api-docs e o Swagger UI ficam desligados. -->
    <springdoc.version>3.0.3</springdoc.version>
    <!-- Biblioteca oficial da Apple para conferir a compra no app (JWS do StoreKit 2 e
         App Store Server Notifications V2). D-094. -->
    <app-store-server-library.version>5.2.0</app-store-server-library.version>
    <!-- Cliente oficial da Google Play Developer API (subscriptionsv2.get e acknowledge) para
         conferir a compra no app Android, com a conta de servico pelo google-auth-library. -->
    <google-androidpublisher.version>v3-rev20260924-2.0.0</google-androidpublisher.version>
    <google-auth.version>1.54.0</google-auth.version>
    <!-- Correcoes de seguranca acima do que o Spring Boot 4.0.8 traz (revisao de 12/10/2026).
         Tomcat 11.0.25+: CVE-2026-65905, -65182 e -68525. Jackson 3.1.7 e 2.21.7: negacao de
         servico ao ler JSON (CVE-2026-89425, -89407, -91777, -91776, -68497) e mais duas.
         Tirar quando o Boot trouxer estas versoes ou maiores. -->
    <tomcat.version>11.0.27</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
    <!-- Guava 33.7.2+: GHSA-xxph-c9ww-hj94 (revisao de 27/10/2026). Vem pelo
         google-auth-library do media; tirar quando ele trouxer esta versao ou maior. -->
    <guava.version>33.7.2-jre</guava.version>
    <!-- Piso padrao de cobertura; cada modulo sobe o seu. -->
    <cobertura.linhas>0.00</cobertura.linhas>
    <cobertura.ramos>0.00</cobertura.ramos>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.piggu</groupId>
        <artifactId>piggu-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.piggu</groupId>
        <artifactId>piggu-testing</artifactId>
        <version>${project.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.apple.itunes.storekit</groupId>
        <artifactId>app-store-server-library</artifactId>
        <version>${app-store-server-library.version}</version>
        <exclusions>
          <!-- So a conferencia das assinaturas e usada; o cliente HTTP da API da Apple fica de fora. -->
          <exclusion>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>com.google.apis</groupId>
        <artifactId>google-api-services-androidpublisher</artifactId>
        <version>${google-androidpublisher.version}</version>
        <exclusions>
          <exclusion>
            <groupId>com.google.guava</groupId>
            <artifactId>listenablefuture</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>com.google.auth</groupId>
        <artifactId>google-auth-library-oauth2-http</artifactId>
        <!-- 1.4x+ usa o google-http-client 2.x, a mesma linha do google-api-client 2.9. -->
        <version>${google-auth.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.api-client</groupId>
        <artifactId>google-api-client</artifactId>
        <version>${google-api-client.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <!-- Lint do Java (checkstyle.xml, na pasta backend): roda no validate, antes de
           compilar, e falha o build. Pula com -Dcheckstyle.skip (o Dockerfile pula: o CI
           ja conferiu). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
          <violationSeverity>error</violationSeverity>
        </configuration>
        <executions>
          <execution>
            <id>lint</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Cobertura por modulo: relatorio em target/site/jacoco e piso no verify.
           O piso de cada modulo fica nas propriedades dele e so sobe. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>agente</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>relatorio</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>piso</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${cobertura.linhas}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${cobertura.ramos}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <environmentVariables>
              <DOCKER_API_VERSION>${docker.api.version}</DOCKER_API_VERSION>
            </environmentVariables>
            <systemPropertyVariables>
              <api.version>${docker.api.version}</api.version>
              <!-- Onde fica o contrato da API que o ContratoDaApiTest compara (docs/api na raiz). -->
              <piggu.contrato.pasta>${project.basedir}/../../docs/api</piggu.contrato.pasta>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
