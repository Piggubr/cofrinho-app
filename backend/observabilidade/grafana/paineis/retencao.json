    {
      "type": "timeseries",
      "title": "Famílias ativas por semana",
      "description": "Famílias que lançaram ao menos um gasto ou receita na semana (Open Finance e conta fixa não contam).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analitico-finance"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analitico-finance"
          },
          "rawSql": "SELECT semana::timestamp AS time, familias AS \"famílias ativas\" FROM analitico.familias_ativas_por_semana WHERE semana BETWEEN $__timeFrom()::date - 6 AND $__timeTo()::date ORDER BY 1",
