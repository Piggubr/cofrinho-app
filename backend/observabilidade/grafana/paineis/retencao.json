    {
      "type": "stat",
      "title": "Voltaram na semana seguinte",
      "description": "Média das 8 últimas turmas: das famílias que começaram a lançar numa semana, quantas lançaram de novo na semana seguinte.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analitico-finance"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analitico-finance"
          },
          "rawSql": "SELECT sum(voltaram_semana_1)::float / nullif(sum(familias), 0)\nFROM (SELECT * FROM analitico.retencao_por_semana WHERE voltaram_semana_1 IS NOT NULL ORDER BY semana DESC LIMIT 8) r",
