    {
      "type": "table",
      "title": "Quantas % voltam a lançar",
      "description": "Cada linha é uma turma: as famílias que lançaram pela primeira vez naquela semana. As colunas mostram quantas % lançaram de novo 1, 2, 4 e 8 semanas depois. Vazio = a semana ainda não terminou.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analitico-finance"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analitico-finance"
          },
          "rawSql": "SELECT to_char(semana, 'DD/MM/YYYY') AS \"Começou na semana de\", familias AS \"Famílias\",\n  round(100.0 * voltaram_semana_1 / familias) AS \"Semana 1 (%)\", round(100.0 * voltaram_semana_2 / familias) AS \"Semana 2 (%)\",\n  round(100.0 * voltaram_semana_4 / familias) AS \"Semana 4 (%)\", round(100.0 * voltaram_semana_8 / familias) AS \"Semana 8 (%)\"\nFROM analitico.retencao_por_semana WHERE semana BETWEEN $__timeFrom()::date - 6 AND $__timeTo()::date ORDER BY semana DESC",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
