            "uid": "analitico-identity"
          },
          "rawSql": "SELECT to_char(mes, 'MM/YYYY') AS \"Mês\", contas AS \"Contas novas\",\n  round(100.0 * confirmaram / contas) AS \"Confirmaram (%)\", round(100.0 * fizeram_teste / contas) AS \"Fizeram teste (%)\",\n  round(100.0 * em_familia_pagante / contas) AS \"Em família pagante (%)\"\nFROM analitico.conversao_por_mes WHERE mes >= date_trunc('month', $__timeFrom()::date) ORDER BY mes DESC",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
