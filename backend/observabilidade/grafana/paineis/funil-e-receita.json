    {
      "type": "stat",
      "title": "Receita mensal estimada",
      "description": "Estimativa: famílias pagando agora × preço de tabela (docs/planos-premium.md), com o anual dividido por 12. Valor bruto, antes da taxa da loja e dos impostos. O período (mensal ou anual) é deduzido do vencimento. Mudou o preço? Atualize a consulta deste painel.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analitico-identity"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analitico-identity"
          },
          "rawSql": "SELECT coalesce(sum(p.familias * CASE p.periodo WHEN 'ANUAL' THEN v.anual / 12 ELSE v.mensal END), 0) FROM analitico.pagantes_por_plano p JOIN (VALUES ('WEB','INDIVIDUAL',19.90,199.00), ('WEB','CASAL',29.90,299.00), ('WEB','FAMILIA',39.99,399.90),\n  ('APP_STORE','INDIVIDUAL',22.89,228.85), ('APP_STORE','CASAL',34.39,343.85), ('APP_STORE','FAMILIA',45.99,459.89),\n  ('PLAY_STORE','INDIVIDUAL',22.89,228.85), ('PLAY_STORE','CASAL',34.39,343.85), ('PLAY_STORE','FAMILIA',45.99,459.89)) v(loja, plano, mensal, anual) USING (loja, plano)",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
