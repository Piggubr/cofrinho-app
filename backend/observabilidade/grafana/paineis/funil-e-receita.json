    {
      "type": "timeseries",
      "title": "Assinaturas novas e encerradas por dia",
      "description": "Novas: começo da assinatura atual (inclui teste grátis). Encerradas: assinatura paga que venceu sem renovar.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analitico-identity"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analitico-identity"
          },
          "rawSql": "SELECT dia::timestamp AS time, assinaturas AS \"novas\" FROM analitico.assinaturas_por_dia WHERE dia BETWEEN $__timeFrom()::date AND $__timeTo()::date ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analitico-identity"
          },
          "rawSql": "SELECT dia::timestamp AS time, familias AS \"encerradas\" FROM analitico.assinaturas_encerradas_por_dia WHERE dia BETWEEN $__timeFrom()::date AND $__timeTo()::date ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
