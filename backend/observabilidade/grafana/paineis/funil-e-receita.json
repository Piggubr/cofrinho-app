    {
      "type": "table",
      "title": "Conversão por mês de cadastro",
      "description": "Das contas criadas em cada mês, quantas % deram cada passo até hoje.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analitico-identity"
