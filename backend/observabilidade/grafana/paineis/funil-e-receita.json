          "rawSql": "SELECT contas AS \"Contas\", contas_confirmadas AS \"Confirmaram o e-mail\", familias AS \"Famílias\",\n  familias_com_teste AS \"Famílias com teste grátis\", familias_que_ja_pagaram AS \"Famílias que já pagaram\",\n  familias_pagando AS \"Famílias pagando agora\", familias_que_sairam AS \"Famílias que saíram\" FROM analitico.funil",
