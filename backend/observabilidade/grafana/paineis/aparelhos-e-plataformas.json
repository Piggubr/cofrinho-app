        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analitico-identity"
          },
          "rawSql": "SELECT CASE plataforma WHEN 'IOS' THEN 'iPhone' WHEN 'ANDROID' THEN 'Android' ELSE plataforma END AS \"Plataforma\", aparelhos AS \"Aparelhos\" FROM analitico.aparelhos_com_push ORDER BY 2 DESC",
