    {
      "type": "piechart",
      "title": "Pessoas por plataforma",
      "description": "Pessoas com sessão aberta (login nos últimos 30 dias, sem sair). Quem usa em dois lugares conta nos dois.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analitico-identity"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analitico-identity"
          },
          "rawSql": "SELECT plataforma AS \"Plataforma\", pessoas AS \"Pessoas\" FROM analitico.sessoes_por_plataforma ORDER BY 2 DESC",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
