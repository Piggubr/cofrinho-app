          },
          "rawSql": "SELECT plataforma AS \"Plataforma\", versao AS \"Versão (iOS: build)\", pessoas AS \"Pessoas\" FROM analitico.versoes_do_app ORDER BY 1, string_to_array(nullif(versao, 'outra'), '.')::int[] DESC NULLS LAST",
