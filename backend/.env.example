# Copie para .env e preencha. O .env nao vai para o Git.

# Obrigatorio: ID OAuth do Google usado no botao de login do site.
GOOGLE_CLIENT_ID=532290439779-olhgd7m1hssj4o30gjs3ngrcs7ga48aa.apps.googleusercontent.com

# Chaves RSA que assinam os tokens. Vazias = usa o par local gerado por
# ./scripts/gerar-chaves-dev.sh (rode uma vez antes do primeiro docker compose up).
# Em producao sao obrigatorias: gere um par novo, fora do repositorio, e passe
# o PEM inteiro ou um caminho file: dentro do container (ex.: secret montado).
# A chave que ja esteve no Git (piggu-dev-private.pem) e publica: nunca a use.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Quem opera a instalacao (separados por virgula). Ao entrar, essas contas viram
# ADMIN. Nenhum e-mail fica no repositorio.
PIGGU_ADMIN_EMAILS=

# dev ou producao. Em producao os servicos recusam subir com a senha padrao do banco,
# com senha curta, com a chave JWT de desenvolvimento ou com a que ja esteve no Git.
PIGGU_AMBIENTE=dev

# Senha do Postgres. "piggu" so serve na sua maquina; em producao use 16+ caracteres:
#   openssl rand -base64 24
DB_PASSWORD=piggu

# Quantos proxies confiaveis ficam na frente dos servicos (contam no X-Forwarded-For
# para o limite de chamadas por IP): 1 so com o gateway, 2 com o Caddy na frente.
PIGGU_LIMITE_PROXIESNAFRENTE=1

# Origens do front autorizadas a chamar a API.
CORS_ORIGINS=http://localhost:4200

# Opcional: reserva da leitura de recibos por foto. O leitor proprio (Tesseract,
# instalado na imagem do finance) tenta primeiro; o Gemini so entra quando a
# soma dos itens lidos nao bate com o total do cupom.
GEMINI_API_KEY=

# Opcional: conexao com bancos por Open Finance (Pluggy). Desligado por padrao:
# o servico so sobe com  docker compose --profile open-finance up  e o card de
# bancos so aparece no painel quando as duas credenciais abaixo estao preenchidas.
# Crie as credenciais em https://dashboard.pluggy.ai. PLUGGY_SANDBOX=true mostra
# os bancos de teste no widget; deixe false em producao.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_SANDBOX=false

# Opcional: assinatura do Piggu Premium pelo site (Stripe). Vazio deixa o botao
# de assinar indisponivel. No painel da Stripe crie um produto com dois precos
# recorrentes em BRL (R$ 19,90/mes e R$ 199/ano) e cole os ids price_... abaixo.
# O webhook aponta para  <API>/api/billing/webhooks/stripe  com os eventos
# customer.subscription.created, .updated e .deleted. Ative o Portal do Cliente
# com cancelamento liberado. SITE_URL e para onde a Stripe devolve a pessoa.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dias gratis do Premium ao assinar pelo site, uma vez por conta (0 desliga).
PIGGU_DIAS_DE_TESTE=7
STRIPE_PRICE_MENSAL=
STRIPE_PRICE_ANUAL=
SITE_URL=http://localhost:4200

# Opcional: compra do Premium dentro dos apps (App Store / Google Play) pelo RevenueCat,
# que valida o recibo com as lojas. No painel do RevenueCat, webhook para
#   <API>/api/billing/stores/app-store/purchases  (e play-store para o Android)
# com o cabecalho Authorization igual a este segredo. Os apps registram o id da conta
# Piggu como app_user_id. Vazio deixa a compra pelos apps em 501.
REVENUECAT_WEBHOOK_SECRET=

# Opcional: habilita busca e sorteio de filmes. Use o "API Read Access Token" (v4,
# comeca com eyJ), que vai no cabecalho. A chave curta v3 e recusada: iria na URL.
TMDB_READ_TOKEN=

# Opcional: guarda as fotos no Google Drive em vez de uma pasta local.
# Aponte para o JSON da conta de servico, por exemplo file:/run/secrets/drive.json
DRIVE_CREDENTIALS=
DRIVE_ROOT_FOLDER_ID=

# Producao (docker compose --profile producao): dominio do site e e-mail do Let's Encrypt.
# Com PIGGU_AMBIENTE=producao, SITE_URL e CORS_ORIGINS precisam ser https://.
# DOMINIO=piggu.app
# EMAIL_DO_CERTIFICADO=voce@exemplo.com
