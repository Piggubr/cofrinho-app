# Copie para .env e preencha. O .env nao vai para o Git.

# Obrigatorio: ID OAuth do Google usado no botao de login do site.
GOOGLE_CLIENT_ID=80166136253-iun0d3ano0st9kdfvl94e803dbjloa6t.apps.googleusercontent.com

# Opcional: Entrar com Apple no app nativo do iPhone. O Bundle ID do app; vazio deixa a rota em 501.
APPLE_CLIENT_IDS=

# Chaves RSA que assinam os tokens. Vazias = usa o par local gerado por
# ./scripts/gerar-chaves-dev.sh (rode uma vez antes do primeiro docker compose up).
# Em producao sao obrigatorias: gere um par novo, fora do repositorio, e passe
# o PEM inteiro ou um caminho file: dentro do container (ex.: secret montado).
# A chave que ja esteve no Git (piggu-dev-private.pem) e publica: nunca a use.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Quem opera a instalacao (separados por virgula). Ao entrar, essas contas viram
# ADMIN. Nenhum e-mail fica no repositorio.
PIGGU_ADMIN_EMAILS=

# Chave que cifra o CPF das contas (32 bytes em base64). Vazia usa a de desenvolvimento;
# em producao e obrigatoria:  openssl rand -base64 32
# Guarde junto com a senha do backup: trocar depois impede ler os CPFs ja guardados.
PIGGU_CPF_CHAVE=

# Desligados por enquanto (11/10/2026). Para voltar, true:
# PIGGU_OPEN_FINANCE  mostra o card de bancos e o Open Finance no Premium (com PLUGGY_*).
# PIGGU_LEITOR_PROPRIO  o leitor proprio (Tesseract) tenta antes do Gemini.
PIGGU_OPEN_FINANCE=false
PIGGU_LEITOR_PROPRIO=false

# dev ou producao. Em producao os servicos recusam subir com a senha padrao do banco,
# com senha curta, com a chave JWT de desenvolvimento ou com a que ja esteve no Git.
PIGGU_AMBIENTE=dev

# Senha do Postgres. "piggu" so serve na sua maquina; em producao use 16+ caracteres:
#   openssl rand -base64 24
# DB_PASSWORD e a do superusuario piggu (backup, restauracao, administracao).
DB_PASSWORD=piggu

# Cada servico entra no banco com o proprio usuario (piggu_identity, piggu_finance...)
# e so alcanca o proprio banco. Em producao, uma senha diferente para cada um; vazias,
# valem DB_PASSWORD. Trocou alguma? Rode de novo o db/init/01-criar-bancos.sh.
DB_PASSWORD_IDENTITY=
DB_PASSWORD_FINANCE=
DB_PASSWORD_REWARDS=
DB_PASSWORD_LIFESTYLE=
DB_PASSWORD_MEDIA=
DB_PASSWORD_BANKING=

# Quantos proxies confiaveis ficam na frente dos servicos (contam no X-Forwarded-For
# para o limite de chamadas por IP): 1 so com o gateway, 2 com o Caddy na frente.
PIGGU_LIMITE_PROXIESNAFRENTE=1

# Origens do front autorizadas a chamar a API.
CORS_ORIGINS=http://localhost:4200

# Opcional: reserva da leitura de recibos por foto. O leitor proprio (Tesseract,
# instalado na imagem do finance) tenta primeiro; o Gemini so entra quando a
# soma dos itens lidos nao bate com o total do cupom.
GEMINI_API_KEY=

# Opcional: conexao com bancos por Open Finance (Pluggy). Desligado por padrao:
# o servico so sobe com  docker compose --profile open-finance up  e o card de
# bancos so aparece no painel quando as duas credenciais abaixo estao preenchidas.
# Crie as credenciais em https://dashboard.pluggy.ai. PLUGGY_SANDBOX=true mostra
# os bancos de teste no widget; deixe false em producao.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_SANDBOX=false

# Opcional: assinatura do Piggu Premium pelo site (Stripe). Vazio deixa o botao
# de assinar indisponivel. No painel da Stripe crie um produto com dois precos
# recorrentes em BRL (R$ 19,90/mes e R$ 199/ano) e cole os ids price_... abaixo.
# O webhook aponta para  <API>/api/billing/webhooks/stripe  com os eventos
# customer.subscription.created, .updated e .deleted. Ative o Portal do Cliente
# com cancelamento liberado. SITE_URL e para onde a Stripe devolve a pessoa.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dias gratis do Premium ao assinar pelo site, uma vez por conta e por CPF (0 desliga).
PIGGU_DIAS_DE_TESTE=14
STRIPE_PRICE_MENSAL=
STRIPE_PRICE_ANUAL=
# Plano familia (ate 5 pessoas da casa): outro produto com R$ 39,99/mes e R$ 399,90/ano.
# Vazio deixa so o individual. No app, os produtos do familia levam "familia" no id.
STRIPE_PRICE_FAMILIA_MENSAL=
STRIPE_PRICE_FAMILIA_ANUAL=
# Plano casal (titular e parceiro): outro produto com R$ 29,90/mes e R$ 299/ano.
# Vazio esconde o casal. No app, os produtos do casal levam "casal" no id.
STRIPE_PRICE_CASAL_MENSAL=
STRIPE_PRICE_CASAL_ANUAL=
SITE_URL=http://localhost:4200

# Opcional: compra do Premium dentro dos apps (App Store / Google Play) pelo RevenueCat,
# que valida o recibo com as lojas. No painel do RevenueCat, webhook para
#   <API>/api/billing/stores/app-store/purchases  (e play-store para o Android)
# com o cabecalho Authorization igual a este segredo. Os apps registram o id da conta
# Piggu como app_user_id. Vazio deixa a compra pelos apps em 501.
REVENUECAT_WEBHOOK_SECRET=

# Compra no app iOS pela Apple (StoreKit 2), sem intermediario. O Apple ID do app esta em
# App Store Connect > App Information; vazio aceita so compras do sandbox (TestFlight).
# Notificacoes V2 da App Store: https://<api>/api/billing/webhooks/app-store
APP_STORE_BUNDLE_ID=br.com.piggu.app
APP_STORE_APP_APPLE_ID=

# Opcional: habilita busca e sorteio de filmes. Use o "API Read Access Token" (v4,
# comeca com eyJ), que vai no cabecalho. A chave curta v3 e recusada: iria na URL.
TMDB_READ_TOKEN=

# Opcional: guarda as fotos no Google Drive em vez de uma pasta local.
# Aponte para o JSON da conta de servico, por exemplo file:/run/secrets/drive.json
DRIVE_CREDENTIALS=
DRIVE_ROOT_FOLDER_ID=

# Producao (docker compose --profile producao): dominio do site e e-mail do Let's Encrypt.
# Com PIGGU_AMBIENTE=producao, SITE_URL e CORS_ORIGINS precisam ser https://.
# DOMINIO=piggu.app
# EMAIL_DO_CERTIFICADO=voce@exemplo.com

# Avisos fora do app (fatura, orcamento, conta do mes). Cada canal so liga com tudo preenchido.
# E-mail pela API da Resend (https://resend.com); o remetente e de um dominio verificado la.
PIGGU_EMAIL_API_KEY=
PIGGU_EMAIL_REMETENTE=
# Push no iPhone: chave .p8 do APNs (developer.apple.com > Keys), em uma linha com \n ou o PEM entre aspas.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_CHAVE=
APNS_BUNDLE_ID=
APNS_SANDBOX=false

# Limite de chamadas por minuto, por IP, para a API inteira (gateway). 0 desliga.
PIGGU_LIMITE_GATEWAY=600

# Formato do log dos servicos: ecs (JSON, que o Loki separa em campos). Vazio volta ao texto.
PIGGU_LOG_FORMATO=ecs

# Monitoramento no proprio servidor (docs/observabilidade.md): Grafana, Prometheus e Loki.
# true: o deploy (deploy/atualizar.sh) sobe junto o perfil observabilidade.
PIGGU_OBSERVABILIDADE=false
# Senha do Grafana (usuario admin). Sem ela o Grafana nao sobe:  openssl rand -base64 18
GRAFANA_SENHA=
# Usuario do painel analitico no Postgres (so le contagens). Trocou? Rode o 01-criar-bancos.sh.
DB_PASSWORD_ANALITICO=
# Para quem vao os alertas e de qual endereco saem (dominio verificado na Resend). O envio
# usa a PIGGU_EMAIL_API_KEY pelo SMTP da Resend; outra conta: GRAFANA_SMTP_HOST/_USUARIO/_SENHA.
PIGGU_ALERTAS_EMAIL=
PIGGU_ALERTAS_REMETENTE=
