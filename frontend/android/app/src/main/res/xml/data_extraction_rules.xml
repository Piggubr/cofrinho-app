<?xml version="1.0" encoding="utf-8"?>
<!-- Nada do Piggu sai do aparelho em backup ou na troca de celular: a sessao (cookie do
     WebView), o perfil offline e os gastos na fila ficam so aqui. Os dados de verdade
     estao no servidor e voltam ao entrar com a conta Google no aparelho novo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
