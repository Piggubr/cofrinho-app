{
  "name": "frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "i18n": "ng extract-i18n --output-path src/locale",
    "start:demo": "ng serve --configuration demo --host 0.0.0.0",
    "build:demo": "ng build --configuration demo",
    "e2e": "playwright test",
    "smoke": "playwright test -c playwright.stack.config.ts --grep @smoke",
    "regressao": "playwright test -c playwright.stack.config.ts --grep @regressao",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/localize": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/service-worker": "^22.2.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@fontsource-variable/sora": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vite": "8.3.5",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
